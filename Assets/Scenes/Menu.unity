  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "C\xE1c \u0111i\u1EC1u khi\u1EC3n trong tr\xF2 ch\u01A1i \u0111\u01B0\u1EE3c
    h\u1ED7 tr\u1EE3 b\u1EB1ng chu\u1ED9t v\xE0 b\xE0n ph\xEDm.\n   - W, M\u0169i
    t\xEAn l\xEAn \u2013 \u0111i l\xEAn\n   - S, M\u0169i t\xEAn xu\u1ED1ng \u2013
    \u0111i xu\u1ED1ng\n   - A, M\u0169i t\xEAn tr\xE1i \u2013 \u0111i sang tr\xE1i\n  
    - D, M\u0169i t\xEAn ph\u1EA3i \u2013 \u0111i sang ph\u1EA3i\n   - E \u2013 m\u1EDF
    t\xFAi \u0111\u1ED3\n   - P \u2013 t\u1EA1m d\u1EEBng tr\xF2 ch\u01A1i\n   -
    Di chuy\u1EC3n chu\u1ED9t \u2013 ch\u1ECDn \u0111\u1ED1i t\u01B0\u1EE3ng \u0111\u1EC3
    t\u01B0\u01A1ng t\xE1c\n   - Chu\u1ED9t tr\xE1i \u2013 th\u1EF1c hi\u1EC7n h\xE0nh
    \u0111\u1ED9ng (ch\u1ECDn v\u1EADt ph\u1EA9m trong t\xFAi \u0111\u1ED3 b\u1EB1ng
    c\xE1ch nh\u1EA5p v\xE0o v\u1EADt ph\u1EA9m, s\u1EED d\u1EE5ng v\u1EADt ph\u1EA9m
    b\u1EB1ng c\xE1ch nh\u1EA5p v\xE0o b\u1EA3n \u0111\u1ED3 khi \u0111\xE3 ch\u1ECDn
    v\u1EADt ph\u1EA9m, \u0103n th\u1EE9c \u0103n b\u1EB1ng c\xE1ch nh\u1EA5p v\xE0o
    nh\xE2n v\u1EADt khi \u0111\xE3 ch\u1ECDn th\u1EE9c \u0103n, nh\xF3m l\u1EEDa
    tr\u1EA1i b\u1EB1ng c\xE1ch nh\u1EA5p v\xE0o n\xF3 khi \u0111\xE3 ch\u1ECDn g\u1ED7,
    mua h\u1EA1t gi\u1ED1ng b\u1EB1ng c\xE1ch nh\u1EA5p v\xE0o ch\xFAng)."
