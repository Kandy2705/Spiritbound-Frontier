    - target: {fileID: 4696826872670194366, guid: 72dff92e3c6ba46fb86dfd78cc9f2394,
        type: 3}
      propertyPath: m_text
      value: "B\u1EA1n c\xF3 th\u1EC3 mua h\u1EA1t gi\u1ED1ng t\u1EEB con v\u1EB9t
        \u2013 n\xF3 s\u1EBD l\xE0 ng\u01B0\u1EDDi b\u1EA1n duy nh\u1EA5t c\u1EE7a
        b\u1EA1n \u1EDF n\u01A1i n\xE0y. Nh\u01B0ng n\xF3 kh\xF4ng th\xE2n thi\u1EC7n
        nh\u01B0 b\u1EA1n ngh\u0129, n\xF3 s\u1EBD kh\xF4ng cho b\u1EA1n mi\u1EC5n
        ph\xED, b\u1EA1n s\u1EBD ph\u1EA3i mua ch\xFAng b\u1EB1ng s\u1ED1 ti\u1EC1n
        nh\u1EADn \u0111\u01B0\u1EE3c t\u1EEB s\u1ED1 ti\u1EC1n b\xE1n qu\u1EA3 v\xE0
        ti\u1EC1n th\u01B0\u1EDFng t\u1EEBng ng\xE0y.\nV\xE0 \u0111\u1EEBng qu\xE1
        bu\u1ED3n b\xE3, n\u1EBFu b\u1EA1n ki\xEAn tr\xEC th\xEC b\u1EA1n s\u1EBD
        c\xF3 m\u1ED9t n\xF4ng tr\u1EA1i tuy\u1EC7t v\u1EDDi \u0111\u1EA5y."
      objectReference: {fileID: 0}
