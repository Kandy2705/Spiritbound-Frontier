PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 5123193586280714470}
    m_Modifications:
    - target: {fileID: 4696826872670194366, guid: 72dff92e3c6ba46fb86dfd78cc9f2394,
        type: 3}
      propertyPath: m_text
      value: "B\u1EA1n b\u1EAFt \u0111\u1EA7u v\u1EDBi m\u1ED9t m\u1EA3nh \u0111\u1EA5t
        nh\u1ECF v\xE0 nhi\u1EC7m v\u1EE5 c\u1EE7a b\u1EA1n l\xE0 ph\xE1t tri\u1EC3n
        n\xF4ng tr\u1EA1i c\u1EE7a ri\xEAng m\xECnh. H\xE3y t\xECm c\xF4ng c\u1EE5,
        h\u1EA1t gi\u1ED1ng v\xE0 c\xE1c ngu\u1ED3n t\xE0i nguy\xEAn c\u1EA7n thi\u1EBFt
        \u0111\u1EC3 b\u1EAFt \u0111\u1EA7u tr\u1ED3ng tr\u1ECDt. D\u1ECDn d\u1EB9p
        \u0111\u1EA5t, gieo h\u1EA1t, t\u01B0\u1EDBi n\u01B0\u1EDBc v\xE0 ch\u0103m
        s\xF3c c\xE2y tr\u1ED3ng \u0111\u1EC3 thu ho\u1EA1ch th\u1EADt nhi\u1EC1u
        n\xF4ng s\u1EA3n. B\u1EA1n c\u0169ng c\xF3 th\u1EC3 ch\u1EB7t c\xE2y \u0111\u1EC3
        l\u1EA5y g\u1ED7, ch\u1EBF t\u1EA1o v\u1EADt d\u1EE5ng v\xE0 m\u1EDF r\u1ED9ng
        n\xF4ng tr\u1EA1i. H\xE3y qu\u1EA3n l\xFD th\u1EDDi gian v\xE0 t\xE0i nguy\xEAn
        th\u1EADt t\u1ED1t \u0111\u1EC3 x\xE2y d\u1EF1ng m\u1ED9t khu v\u01B0\u1EDDn
        xanh t\u1ED1t v\xE0 ng\xE0y c\xE0ng ph\xE1t tri\u1EC3n. B\xEAn c\u1EA1nh
        \u0111\xF3 ch\xFAng t\xF4i c\xF3 m\u1ED9t v\xE0i l\u1EDDi khuy\xEAn d\xE0nh
        cho b\u1EA1n:"
      objectReference: {fileID: 0}
